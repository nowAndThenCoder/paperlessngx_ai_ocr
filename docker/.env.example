# Netzwerk & URLs
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL_VL=vision-model:latest
OLLAMA_MODEL_TEXTEMBED=nomic-embed-text
OLLAMA_TIMEOUT=4800
OLLAMA_DPI=300
REGISTRY_URL=dockerregistry.home.local

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=very_secure

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Application Settings
LOG_LEVEL=DEBUG
LANCEDB_DATA_DIR="./lancedb_data"
MAX_PARALLEL_JOBS=1
MAX_THREADS_PER_JOB=1
PYTHONUNBUFFERED=1
